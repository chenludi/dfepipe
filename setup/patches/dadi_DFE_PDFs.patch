+def neugamma(xx, params):
+    """Return Neutral + Gamma distribution"""
+    """params = (shape, scale, pneu)
+    pneu is the proportion of neutral mutations"""
+    alpha, beta, pneu = params
+    xx = np.atleast_1d(xx)
+    out = (1-pneu)*ssd.gamma.pdf(xx, alpha, scale=beta)
+    # Assume gamma < 1e-4 is essentially neutral
+    out[np.logical_and(0 <= xx, xx < 1e-4)] += pneu/1e-4
+    # Reduce xx back to scalar if it's possible
+    return np.squeeze(out)
+
+
+
+def gammaneud1(xx, params):
+    """Return Neutral + Pointmass deleterious +Gamma distribution"""
+    """params = (shape, scale, pneu)
+    This is a mixed of two point mass distribution and a gamma distribution.
+    A point mass of neutral mutation 
+    and a point mass slightly deleterious mutation on top of gamma distribution. 
+    """
+    alpha, beta, pneu, pdele, Na, sneu, sdeles,sdelel= params
+    xx = np.atleast_1d(xx)
+    # Assume gamma < 1e-4 is essentially neutral
+    # 2024/11/20
+    # if gammaneu is not provided, assume it's 1e-4
+    # Change it to 2Nas approximately 1e-5, Na is about 18000. 
+    # gammaneu = 1e-4
+    gammaneu = 2*Na*sneu
+    gammadeles= 2*Na*sdeles
+    gammadelel= 2*Na*sdelel
+    pgamma=1-pneu-pdele
+    out = (1-pneu-pdele)*ssd.gamma.pdf(xx,loc=0, a=alpha, scale=beta)
+    out[np.logical_and(0 <= xx, xx < gammaneu)] += pneu/gammaneu
+    if sdeles<sdelel:
+        out[np.logical_and(gammadeles <= xx, xx < gammadelel)] += pdele/(gammadelel-gammadeles)
+    elif sdeles>sdelel:
+        out[np.logical_and(gammadelel <= xx, xx < gammadeles)] += pdele/(gammadeles-gammadelel)
+    else:
+        print("Warning: range of point mass deleterious mutation is zero")
+    # Reduce xx back to scalar if it's possible
+    return np.squeeze(out)
